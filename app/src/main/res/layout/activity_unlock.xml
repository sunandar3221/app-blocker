<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="24dp"
        android:layout_margin="16dp"
        android:elevation="12dp">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_lock"
            android:contentDescription="Kunci" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="Keluar dari Kiosk Mode"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Masukkan PIN untuk membuka kunci dan keluar dari mode Kiosk."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- PIN Display / Input -->
        <EditText
            android:id="@+id/etUnlockPin"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input"
            android:hint="••••"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:inputType="numberPassword"
            android:textAlignment="center"
            android:textSize="24sp"
            android:letterSpacing="0.3"
            android:maxLength="10"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <TextView
            android:id="@+id/tvUnlockError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/status_red"
            android:textSize="13sp"
            android:gravity="center" />

        <!-- Built-in On-screen Numeric Keypad (Foolproof Kiosk Keypad) -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:stretchColumns="*">

            <TableRow android:layout_marginBottom="8dp">
                <Button android:id="@+id/btnKey1" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="1" android:textSize="20sp" android:textColor="@color/text_primary" android:layout_margin="3dp" />
                <Button android:id="@+id/btnKey2" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="2" android:textSize="20sp" android:textColor="@color/text_primary" android:layout_margin="3dp" />
                <Button android:id="@+id/btnKey3" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="3" android:textSize="20sp" android:textColor="@color/text_primary" android:layout_margin="3dp" />
            </TableRow>

            <TableRow android:layout_marginBottom="8dp">
                <Button android:id="@+id/btnKey4" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="4" android:textSize="20sp" android:textColor="@color/text_primary" android:layout_margin="3dp" />
                <Button android:id="@+id/btnKey5" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="5" android:textSize="20sp" android:textColor="@color/text_primary" android:layout_margin="3dp" />
                <Button android:id="@+id/btnKey6" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="6" android:textSize="20sp" android:textColor="@color/text_primary" android:layout_margin="3dp" />
            </TableRow>

            <TableRow android:layout_marginBottom="8dp">
                <Button android:id="@+id/btnKey7" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="7" android:textSize="20sp" android:textColor="@color/text_primary" android:layout_margin="3dp" />
                <Button android:id="@+id/btnKey8" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="8" android:textSize="20sp" android:textColor="@color/text_primary" android:layout_margin="3dp" />
                <Button android:id="@+id/btnKey9" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="9" android:textSize="20sp" android:textColor="@color/text_primary" android:layout_margin="3dp" />
            </TableRow>

            <TableRow>
                <Button android:id="@+id/btnKeyClear" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="C" android:textSize="18sp" android:textColor="@color/status_red" android:layout_margin="3dp" />
                <Button android:id="@+id/btnKey0" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="0" android:textSize="20sp" android:textColor="@color/text_primary" android:layout_margin="3dp" />
                <Button android:id="@+id/btnKeyBack" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="⌫" android:textSize="20sp" android:textColor="@color/accent" android:layout_margin="3dp" />
            </TableRow>
        </TableLayout>

        <Button
            android:id="@+id/btnConfirmUnlock"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button"
            android:text="Buka Kunci &amp; Keluar"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnCancelUnlock"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackground"
            android:text="Kembali ke Aplikasi Kiosk"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
