<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="28dp"
    android:layout_margin="20dp"
    android:elevation="12dp">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic_lock"
        android:contentDescription="Kunci" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="Keluar dari Kiosk Mode"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Masukkan PIN rahasia untuk membuka kunci dan keluar dari mode Kiosk."
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etUnlockPin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_input"
        android:hint="Masukkan PIN"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:inputType="numberPassword"
        android:textAlignment="center"
        android:textSize="22sp"
        android:letterSpacing="0.2"
        android:maxLength="10"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <TextView
        android:id="@+id/tvUnlockError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/status_red"
        android:textSize="13sp"
        android:gravity="center" />

    <Button
        android:id="@+id/btnConfirmUnlock"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button"
        android:text="Buka Kunci &amp; Keluar"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnCancelUnlock"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:text="Kembali ke Aplikasi Kiosk"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

</LinearLayout>
