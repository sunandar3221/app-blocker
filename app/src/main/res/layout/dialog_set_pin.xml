<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="24dp"
    android:layout_margin="16dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic_lock"
        android:contentDescription="PIN" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="Buat PIN Pengaman Kiosk"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="PIN ini wajib dimasukkan untuk keluar dari Kiosk Mode nanti. Jangan sampai lupa!"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etNewPin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_input"
        android:hint="Masukkan PIN Baru (misal: 1234)"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:inputType="numberPassword"
        android:maxLength="10"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <EditText
        android:id="@+id/etConfirmPin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input"
        android:hint="Konfirmasi PIN Baru"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:inputType="numberPassword"
        android:maxLength="10"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <TextView
        android:id="@+id/tvPinError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/status_red"
        android:textSize="13sp"
        android:gravity="center" />

    <Button
        android:id="@+id/btnSavePin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button"
        android:text="Simpan PIN"
        android:textColor="@color/white"
        android:textStyle="bold" />

</LinearLayout>
