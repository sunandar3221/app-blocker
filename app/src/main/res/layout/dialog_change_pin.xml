<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="24dp"
    android:layout_margin="16dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic_lock"
        android:contentDescription="PIN" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="Ganti PIN Kiosk"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Masukkan PIN lama Anda sebelum menentukan PIN baru."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etOldPin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_input"
        android:hint="Masukkan PIN Lama"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:inputType="numberPassword"
        android:maxLength="10"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <EditText
        android:id="@+id/etNewPinChange"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input"
        android:hint="Masukkan PIN Baru (min. 4 angka)"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:inputType="numberPassword"
        android:maxLength="10"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <EditText
        android:id="@+id/etConfirmPinChange"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input"
        android:hint="Konfirmasi PIN Baru"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:inputType="numberPassword"
        android:maxLength="10"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <TextView
        android:id="@+id/tvChangePinError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/status_red"
        android:textSize="13sp"
        android:gravity="center" />

    <Button
        android:id="@+id/btnSubmitChangePin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button"
        android:text="Simpan PIN Baru"
        android:textColor="@color/white"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCancelChangePin"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackground"
        android:text="Batal"
        android:textColor="@color/text_secondary" />

</LinearLayout>
